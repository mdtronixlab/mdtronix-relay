{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mdtronix-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "routes": [
    { "pattern": "relay.mdtronix.online", "custom_domain": true },
    { "pattern": "*.mdtronix.online/*", "zone_name": "mdtronix.online" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "TUNNEL", "class_name": "TunnelDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TunnelDO"] }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://relay.mdtronix.online",
    "TUNNEL_PUBLIC_HOST": "relay.mdtronix.online",
    "INSTANCE_DOMAIN": "mdtronix.online",
    // The Alexa account-linking client ID is public. It must match the value entered in the Alexa skill.
    "ALEXA_CLIENT_ID": "mdtronix-alexa",
    // The skill's "Send Alexa Events" LWA client ID (Build > Permissions). Used with ALEXA_LWA_CLIENT_SECRET
    // to authenticate proactive ChangeReport calls to Alexa's Event Gateway. Public, like the other client IDs.
    "ALEXA_LWA_CLIENT_ID": "amzn1.application-oa2-client.8e06c6bc69054f1e8f8763242fbc6a0e",
    // The Google Home account-linking client ID is public. It must match the value entered in the
    // Home Developer Console's cloud-to-cloud integration (Account linking > OAuth client ID).
    "GOOGLE_VOICE_CLIENT_ID": "mdtronix-cloud-google-024eae927ee03386",
    // Secrets, set at deploy with `wrangler secret put`: ALEXA_CLIENT_SECRET, ALEXA_LWA_CLIENT_SECRET,
    // GOOGLE_VOICE_CLIENT_SECRET.
    // DEV_LOGIN is never set here. It exists only in the local .dev.vars file.
  },
  // Rate limits. Period is 60 seconds, the longest the binding supports for this setup. Key is the caller's IP.
  // RL_LOGIN is the website's /login and /register; RL_HA_LOGIN is the HA integration's own direct
  // email+password login (POST /v1/ha/login) — split so one flow's volume can't starve the other.
  "ratelimits": [
    { "name": "RL_LOGIN", "namespace_id": "1004", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_HA_LOGIN", "namespace_id": "1005", "simple": { "limit": 20, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "CUSTOMERS",
      "database_name": "mdtronix-customers",
      "database_id": "c5c1221a-61a8-4a92-8fc2-e7c1dba4a80d"
    }
  ]
  // Account: the same Cloudflare account as mdtronix-portal (see docs/remote-access/PHASE0.md).
  // Plan: Workers Paid, for Durable Object WebSocket volume.
}
